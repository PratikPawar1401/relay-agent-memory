# Copy only when overriding defaults. CLI/API read the process environment.
RELAY_DB_HOST=127.0.0.1
RELAY_DB_PORT=6380
RELAY_SANDBOX_URL=http://127.0.0.1:8091
# Local model endpoint.
RELAY_OLLAMA_URL=http://127.0.0.1:11434
RELAY_OLLAMA_MODEL=mistral:latest
# Gemini uses structured JSON output and is selected explicitly in the console.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=  (accepted as an alternative to GEMINI_API_KEY)
RELAY_GEMINI_MODEL=gemini-3.8-flash
RELAY_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GRAPHITI_TELEMETRY_ENABLED=false
